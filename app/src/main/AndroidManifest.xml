<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lembrete "Bedtime" (pede-se ao ligar o interruptor nas definições). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voltar a agendar o lembrete depois de o telemóvel reiniciar. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Hápticos compostos (apagar e repor uma rotina; ver ui/haptics/CycloHaptics.kt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Ver se há uma versão nova nas releases do GitHub (ver update/CycloUpdates.kt). Desde o
         Cyclo 2.0 a app não descarrega nem instala o .apk (sem REQUEST_INSTALL_PACKAGES): o aviso
         abre a página da release. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".CycloApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:resizeableActivity="false"
        android:theme="@style/Theme.Cyclo">
        <!-- Só retrato, sem ecrã dividido nem janelas flutuantes (pop-up view da One UI):
             resizeableActivity="false" + screenOrientation="portrait". Os widgets não dependem
             disto (o launcher é que os desenha). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cyclo"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:configChanges="locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lembrete "Bedtime": o alarme (inexato) e os eventos que o desfazem ou mudam as horas. -->
        <receiver
            android:name=".reminder.BedtimeAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- A língua do sistema mudou: o widget e o canal das notificações mudam de textos. -->
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Widget Studio (beta-3.0): abre-se pelas definições de um widget no lançador (android:configure
             dos dois widgets). Exportada porque é o lançador que a abre. A janela mostra a wallpaper
             (Theme.Cyclo.Studio); só retrato, como a app. -->
        <activity
            android:name=".widget.WidgetStudioActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Cyclo.Studio"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:configChanges="locale|layoutDirection"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Routine Widget (o nome da classe fica o de antes: os widgets já postos continuam a funcionar). -->
        <receiver
            android:name=".widget.BedtimeWidgetProvider"
            android:exported="false"
            android:label="@string/widget_routine_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bedtime_info" />
        </receiver>
        <!-- Wake Time Widget: o wake-time-container do Feed. -->
        <receiver
            android:name=".widget.WakeTimeWidgetProvider"
            android:exported="false"
            android:label="@string/widget_wake_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wake_time_info" />
        </receiver>
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />
        <!-- O visto do widget (liga e desliga a rotina). -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />
    </application>

</manifest>
