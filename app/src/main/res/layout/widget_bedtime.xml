<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget grande (≥ 250 x 176 dp: 4 x 2 alto, 4 x 3 e maiores). Versão compacta do cartão das
    rotinas guardadas (routine 1, Figma 73:419), com a mesma hierarquia: fundo #101011 opaco, raio 15,
    margens de 15.
    - Em cima: o nome (SemiBold 14) e, por baixo, o sol e a hora de acordar; à direita, os botões
      editar e ligar/desligar (círculos de 34 dp em zonas de toque de 48 dp).
    - O calendário e a repetição (os dias da rotina a branco, os outros a #A3A2A7 a 39 %).
    - O espaço que sobra fica no meio; em baixo, a hora de ir para a cama em grande (com "In bed by"
      por cima) e a lua com a hora de começar a abrandar. As duas horas estão em ViewFlippers: ao
      mudar, a nova entra por baixo e a antiga sai por cima.
    - Desligada, o véu "fx upper-shadow" (#101011 a 63 %) por cima do texto e por baixo dos botões.
    O id @android:id/background deixa o lançador recortar os cantos.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- Nome e hora de acordar, ao lado dos botões (2 x 48 dp, menos a margem de toque). -->
        <TextView
            android:id="@+id/widget_name"
            style="@style/CycloWidgetName"
            android:layout_marginEnd="92dp" />

        <LinearLayout
            style="@style/CycloWidgetRow"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="92dp">

            <ImageView
                style="@style/CycloWidgetIcon"
                android:src="@drawable/widget_ic_sunny" />

            <TextView
                android:id="@+id/widget_wake"
                style="@style/CycloWidgetValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_repeat_row"
            style="@style/CycloWidgetRow"
            android:layout_marginTop="8dp">

            <ImageView
                style="@style/CycloWidgetIcon"
                android:src="@drawable/widget_ic_calendar" />

            <TextView
                android:id="@+id/widget_repeat"
                style="@style/CycloWidgetValue" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/widget_bed_label_row"
            style="@style/CycloWidgetRow">

            <ImageView
                style="@style/CycloWidgetIcon"
                android:src="@drawable/widget_ic_star" />

            <TextView
                android:id="@+id/widget_bed_label"
                style="@style/CycloWidgetLabel"
                android:text="@string/widget_bed_label" />
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/widget_bedtime_flipper"
            style="@style/CycloWidgetFlipper"
            android:layout_height="36dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_bedtime_a"
                style="@style/CycloWidgetHero"
                android:autoSizeMaxTextSize="32sp" />

            <TextView
                android:id="@+id/widget_bedtime_b"
                style="@style/CycloWidgetHero"
                android:autoSizeMaxTextSize="32sp" />
        </ViewFlipper>

        <LinearLayout
            style="@style/CycloWidgetRow"
            android:layout_marginTop="4dp">

            <ImageView
                style="@style/CycloWidgetIcon"
                android:src="@drawable/widget_ic_bedtime" />

            <ViewFlipper
                android:id="@+id/widget_winddown_flipper"
                style="@style/CycloWidgetFlipper">

                <TextView
                    android:id="@+id/widget_winddown_a"
                    style="@style/CycloWidgetValue" />

                <TextView
                    android:id="@+id/widget_winddown_b"
                    style="@style/CycloWidgetValue" />
            </ViewFlipper>
        </LinearLayout>
    </LinearLayout>

    <!-- fx upper-shadow (só com a rotina desligada). -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_veil"
        android:visibility="gone" />

    <!-- Os botões: círculos de 34 dp em zonas de toque de 48 dp, encostados em cima à direita (os
         7 dp de margem de toque mais 8 dp dão os 15 dp até à borda; 14 dp entre os círculos). -->
    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_edit"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_button"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_edit" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/widget_toggle_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_toggle_on"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_active" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
