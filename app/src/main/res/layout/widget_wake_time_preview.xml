<?xml version="1.0" encoding="utf-8"?>
<!--
    Pré-visualização do Wake Time Widget na lista de widgets do lançador: o Figma 244:107 com os
    valores de exemplo dele. TextViews com a fonte do sistema.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="345dp"
        android:layout_height="171dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_background">

        <ImageView
            style="@style/CycloWidgetPreviewIcon"
            android:layout_marginStart="15dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/widget_ic_sunny" />

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_marginStart="36dp"
            android:layout_marginTop="15dp"
            android:text="@string/widget_preview_wake" />

        <!-- separator: 0,5 dp, #A3A2A7 a 15 %. -->
        <ImageView
            android:layout_width="315dp"
            android:layout_height="0.5dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="48dp"
            android:background="#26A3A2A7"
            android:importantForAccessibility="no" />

        <ImageView
            style="@style/CycloWidgetPreviewIcon"
            android:layout_marginStart="138dp"
            android:layout_marginTop="63dp"
            android:src="@drawable/widget_ic_star" />

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_width="44dp"
            android:layout_marginStart="124dp"
            android:layout_marginTop="84dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:text="@string/widget_preview_bed_0" />

        <ImageView
            style="@style/CycloWidgetPreviewIcon"
            android:layout_marginStart="195dp"
            android:layout_marginTop="63dp"
            android:src="@drawable/widget_ic_star" />

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_width="39dp"
            android:layout_marginStart="183dp"
            android:layout_marginTop="84dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:text="@string/widget_preview_bed_1" />

        <ImageView
            style="@style/CycloWidgetPreviewIcon"
            android:layout_marginStart="80dp"
            android:layout_marginTop="117dp"
            android:src="@drawable/widget_ic_satisfied" />

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_width="39dp"
            android:layout_marginStart="68dp"
            android:layout_marginTop="138dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:text="@string/widget_preview_bed_2" />

        <ImageView
            style="@style/CycloWidgetPreviewIcon"
            android:layout_marginStart="134dp"
            android:layout_marginTop="117dp"
            android:src="@drawable/widget_ic_neutral" />

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_width="39dp"
            android:layout_marginStart="122dp"
            android:layout_marginTop="138dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:text="@string/widget_preview_bed_3" />

        <ImageView
            style="@style/CycloWidgetPreviewIcon"
            android:layout_marginStart="190dp"
            android:layout_marginTop="117dp"
            android:src="@drawable/widget_ic_dissatisfied" />

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_width="44dp"
            android:layout_marginStart="176dp"
            android:layout_marginTop="138dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:text="@string/widget_preview_bed_4" />

        <ImageView
            style="@style/CycloWidgetPreviewIcon"
            android:layout_marginStart="248dp"
            android:layout_marginTop="117dp"
            android:src="@drawable/widget_ic_dissatisfied" />

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_width="42dp"
            android:layout_marginStart="235dp"
            android:layout_marginTop="138dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:text="@string/widget_preview_bed_5" />
    </FrameLayout>
</FrameLayout>
