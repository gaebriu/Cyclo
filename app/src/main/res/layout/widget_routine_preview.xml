<?xml version="1.0" encoding="utf-8"?>
<!--
    Pré-visualização do Routine Widget na lista de widgets do lançador: o Figma 244:48 com os valores
    de exemplo dele ("Routine 1", 06:00, "Show just this once"). TextViews com a fonte do sistema.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="345dp"
        android:layout_height="164dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_background">

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:text="@string/widget_preview_name" />

        <ImageView
            style="@style/CycloWidgetPreviewIcon"
            android:layout_marginStart="15dp"
            android:layout_marginTop="48dp"
            android:src="@drawable/widget_ic_sunny" />

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_marginStart="36dp"
            android:layout_marginTop="47dp"
            android:text="@string/widget_preview_wake" />

        <ImageView
            style="@style/CycloWidgetPreviewIcon"
            android:layout_marginStart="15dp"
            android:layout_marginTop="78dp"
            android:src="@drawable/widget_ic_calendar" />

        <TextView
            style="@style/CycloWidgetPreviewText"
            android:layout_marginStart="36dp"
            android:layout_marginTop="77dp"
            android:text="@string/repeat_just_once" />

        <ImageView
            android:layout_width="39dp"
            android:layout_height="39dp"
            android:layout_marginStart="237dp"
            android:layout_marginTop="110dp"
            android:background="@drawable/widget_button"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_edit" />

        <ImageView
            android:layout_width="39dp"
            android:layout_height="39dp"
            android:layout_marginStart="291dp"
            android:layout_marginTop="110dp"
            android:background="@drawable/widget_toggle_on"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_active" />
    </FrameLayout>
</FrameLayout>
