<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget largo e baixo (≥ 180 dp de largura e menos de 176 de altura: 3 x 2 e 4 x 2 na maior parte
    dos lançadores). A versão mais compacta do cartão das rotinas guardadas, em quatro linhas de
    16 dp: o nome (SemiBold 14), o sol e a hora de acordar, a estrela e "In bed by ...", a lua e
    "Wind down at ..." (as duas últimas em ViewFlippers). Margens de 12 dp.
    - Com ≥ 250 dp de largura, os botões editar e ligar/desligar ficam empilhados à direita
      (círculos de 34 dp em zonas de toque de 48 dp); mais estreito, saem (o widget abre a app).
    - A repetição não cabe a esta altura: está no widget grande e no pequeno alto.
    - Desligada, o véu "fx upper-shadow" por cima do texto e por baixo dos botões.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11dp">

        <!-- Tudo o que fica ao lado dos botões (o código põe a margem a 0 quando eles saem). -->
        <LinearLayout
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="44dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name"
                style="@style/CycloWidgetName" />

            <LinearLayout
                style="@style/CycloWidgetRow"
                android:layout_marginTop="8dp">

                <ImageView
                    style="@style/CycloWidgetIcon"
                    android:src="@drawable/widget_ic_sunny" />

                <TextView
                    android:id="@+id/widget_wake"
                    style="@style/CycloWidgetValue" />
            </LinearLayout>

            <LinearLayout
                style="@style/CycloWidgetRow"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CycloWidgetIcon"
                    android:src="@drawable/widget_ic_star" />

                <ViewFlipper
                    android:id="@+id/widget_bedtime_flipper"
                    style="@style/CycloWidgetFlipper">

                    <TextView
                        android:id="@+id/widget_bedtime_a"
                        style="@style/CycloWidgetValue" />

                    <TextView
                        android:id="@+id/widget_bedtime_b"
                        style="@style/CycloWidgetValue" />
                </ViewFlipper>
            </LinearLayout>

            <LinearLayout
                style="@style/CycloWidgetRow"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CycloWidgetIcon"
                    android:src="@drawable/widget_ic_bedtime" />

                <ViewFlipper
                    android:id="@+id/widget_winddown_flipper"
                    style="@style/CycloWidgetFlipper">

                    <TextView
                        android:id="@+id/widget_winddown_a"
                        style="@style/CycloWidgetValue" />

                    <TextView
                        android:id="@+id/widget_winddown_b"
                        style="@style/CycloWidgetValue" />
                </ViewFlipper>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- fx upper-shadow (só com a rotina desligada). -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_veil"
        android:visibility="gone" />

    <!-- Os botões empilhados: os 7 dp de margem de toque mais 5 dp dão os 12 dp até à borda. -->
    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="5dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/widget_edit"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_button"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_edit" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/widget_toggle_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_toggle_on"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_active" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
