<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Uma hora do Wake Time Widget: a nova entra por baixo, a antiga sai por cima. -->
    <style name="CycloWidgetSlot">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_gravity">top|start</item>
        <item name="android:inAnimation">@anim/widget_time_in</item>
        <item name="android:outAnimation">@anim/widget_time_out</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="CycloWidgetSlotText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
