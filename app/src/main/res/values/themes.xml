<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Ecrã de abertura: totalmente #010101, sem o ícone da app (o ícone é um vetor transparente).
        O fundo da janela também é #010101, para não aparecer branco entre a abertura e o primeiro ecrã.
    -->
    <style name="Theme.Cyclo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cyclo_background</item>
        <item name="android:windowSplashScreenBackground">@color/cyclo_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
    </style>

    <!--
        Widget Studio (beta-3.0): janela opaca que mostra a wallpaper do utilizador por baixo
        (windowShowWallpaper; o fundo é transparente e a página pinta #010101 à volta do preview).
        Sem animação de janela: a página sobe e desce sozinha, como as definições.
    -->
    <style name="Theme.Cyclo.Studio" parent="Theme.Cyclo">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
